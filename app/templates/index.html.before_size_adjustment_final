    margin: 0;
    padding: 24px 24px;

    box-sizing: border-box;

    display: flex;
    flex-direction: column;
    justify-content: center;

    overflow: hidden;

    scroll-margin-top: var(--slide-navbar-height);
}
            /* Home */
            #home {
                padding: 0;
