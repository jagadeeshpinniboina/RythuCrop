<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RythuCrop | Smart Agriculture</title>

    <style>
        :root{
            --green:#087f5b;
            --green-dark:#075c43;
            --green-soft:#eaf7f1;
            --accent:#f4a340;
            --text:#17352b;
            --muted:#61756d;
            --card:#ffffff;
            --bg:#f7fbf8;
            --border:#dcebe4;
            --shadow:0 18px 50px rgba(17,70,52,.10);
        }

        *{box-sizing:border-box;margin:0;padding:0}
        html{scroll-behavior:smooth}
        body{
            font-family:Arial,Helvetica,sans-serif;
            background:var(--bg);
            color:var(--text);
            line-height:1.6;
        }
        body.dark{
            --text:#edf8f2;
            --muted:#b5c8c0;
            --card:#12352a;
            --bg:#071c15;
            --border:#285044;
            --green-soft:#123e31;
            --shadow:0 18px 50px rgba(0,0,0,.25);
        }
        a{text-decoration:none;color:inherit}
        button,input,select{font:inherit}
        button{cursor:pointer}

        .navbar{
            position:sticky;
            top:0;
            z-index:1000;
            background:rgba(255,255,255,.94);
            backdrop-filter:blur(14px);
            border-bottom:1px solid var(--border);
        }
        body.dark .navbar{background:rgba(7,28,21,.94)}
        .nav-container{
            max-width:1250px;
            margin:auto;
            padding:14px 24px 10px;
        }
        .nav-main{
            min-height:58px;
            display:flex;
            align-items:center;
            justify-content:space-between;
            gap:20px;
        }
        .brand{display:flex;align-items:center;gap:10px;font-size:21px;font-weight:800}
        .brand-icon{
            width:40px;height:40px;border-radius:50%;
            display:grid;place-items:center;
            background:var(--green);color:white;
        }
        nav{display:flex;align-items:center;gap:25px}
        nav a{font-size:14px;font-weight:700;color:var(--muted)}
        nav a:hover,nav a.active{color:var(--green)}
        .nav-controls{
            display:flex;
            justify-content:flex-end;
            align-items:center;
            gap:10px;
            padding:4px 0 2px;
        }
        .control{
            border:1px solid var(--border);
            background:var(--card);
            color:var(--text);
            border-radius:999px;
            padding:8px 12px;
        }
        .language{min-width:130px}
        .theme-btn{width:42px;height:38px;padding:0}
        .mobile-menu{display:none}

        section{scroll-margin-top:120px}
        .hero{
            min-height:700px;
            display:flex;
            align-items:center;
            position:relative;
            overflow:hidden;
            color:white;
            background:
                linear-gradient(90deg,rgba(4,34,24,.90) 0%,rgba(4,34,24,.67) 46%,rgba(4,34,24,.24) 100%),
                url("{{ url_for('static', filename='farmer-rice.png') }}") center/cover no-repeat;
        }
        .hero::after{
            content:"";
            position:absolute;inset:auto 0 0;
            height:120px;
            background:linear-gradient(transparent,var(--bg));
        }
        .hero-inner{
            width:min(1250px,100%);
            margin:auto;
            padding:90px 24px 130px;
            position:relative;
            z-index:2;
        }
        .badge{
            display:inline-block;
            padding:8px 14px;
            border-radius:999px;
            background:rgba(255,255,255,.13);
            border:1px solid rgba(255,255,255,.25);
            font-size:12px;
            font-weight:800;
            letter-spacing:.7px;
        }
        .hero h1{
            max-width:720px;
            font-size:clamp(42px,6vw,78px);
            line-height:1.02;
            margin:22px 0;
        }
        .hero h1 span{color:#7de1b7}
        .hero p{max-width:680px;color:#e4f1eb;font-size:18px}
        .hero-buttons{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}
        .btn{
            display:inline-flex;
            align-items:center;
            justify-content:center;
            border:0;
            border-radius:12px;
            padding:13px 20px;
            font-weight:800;
            transition:.2s;
        }
        .btn-primary{background:var(--accent);color:#3b270f}
        .btn-secondary{background:rgba(255,255,255,.12);color:white;border:1px solid rgba(255,255,255,.35)}
        .btn:hover{transform:translateY(-2px)}

        .weather-card{
            position:absolute;
            right:6%;
            bottom:20%;
            z-index:3;
            width:285px;
            padding:22px;
            border-radius:24px;
            background:rgba(255,255,255,.14);
            border:1px solid rgba(255,255,255,.30);
            backdrop-filter:blur(14px);
        }
        .weather-card small{opacity:.8}
        .weather-temp{font-size:42px;font-weight:900;margin:8px 0}

        .section{
            max-width:1250px;
            margin:auto;
            padding:90px 24px;
        }
        .section-heading{max-width:780px;margin-bottom:35px}
        .eyebrow{
            color:var(--green);
            font-size:12px;
            font-weight:900;
            letter-spacing:1.5px;
        }
        .section-heading h2{font-size:clamp(30px,4vw,50px);line-height:1.1;margin:10px 0 15px}
        .section-heading p{color:var(--muted);font-size:17px}

        .planner{
            display:grid;
            grid-template-columns:1.1fr .9fr;
            gap:24px;
        }
        .card{
            background:var(--card);
            border:1px solid var(--border);
            border-radius:24px;
            padding:28px;
            box-shadow:var(--shadow);
        }
        .form-grid{
            display:grid;
            grid-template-columns:repeat(2,1fr);
            gap:18px;
        }
        .form-group{display:flex;flex-direction:column;gap:7px}
        label{font-weight:800;font-size:14px}
        input,select{
            width:100%;
            border:1px solid var(--border);
            background:var(--bg);
            color:var(--text);
            border-radius:12px;
            padding:13px 14px;
            outline:none;
        }
        input:focus,select:focus{border-color:var(--green);box-shadow:0 0 0 3px rgba(8,127,91,.10)}
        .full{grid-column:1/-1}
        .result-panel{
            background:linear-gradient(145deg,var(--green),var(--green-dark));
            color:white;
            border-radius:24px;
            padding:30px;
            min-height:100%;
        }
        .result-panel h3{font-size:28px;margin:10px 0}
        .recommendation-list{display:grid;gap:12px;margin-top:20px}
        .recommendation-item{
            background:rgba(255,255,255,.10);
            border:1px solid rgba(255,255,255,.18);
            border-radius:14px;
            padding:13px;
        }
        .check-row{display:flex;gap:10px;align-items:flex-start}
        .check-row input{width:auto;margin-top:5px}

        .capability-grid{
            display:grid;
            grid-template-columns:repeat(3,1fr);
            gap:20px;
        }
        .capability-card{
            background:var(--card);
            border:1px solid var(--border);
            border-radius:22px;
            padding:25px;
            transition:.2s;
        }
        .capability-card:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
        .icon{
            width:48px;height:48px;border-radius:15px;
            display:grid;place-items:center;
            background:var(--green-soft);
            color:var(--green);
            font-size:23px;
            margin-bottom:18px;
        }
        .capability-card h3{margin-bottom:7px}
        .capability-card p{color:var(--muted)}

        .about-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
        .about-card{padding:28px;border-radius:22px;background:var(--card);border:1px solid var(--border)}
        .about-card p{color:var(--muted);margin-top:8px}

        .hidden{display:none!important}
        .success{color:#7de1b7;font-weight:900}
        .error{color:#ffb4a8;font-weight:800}
        .loading{opacity:.7}

        footer{
            background:#082b20;
            color:#dceee7;
            padding:45px 24px;
        }
        .footer-inner{
            max-width:1250px;margin:auto;
            display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;
        }

        @media(max-width:950px){
            nav{display:none}
            .mobile-menu{display:block;border:1px solid var(--border);background:var(--card);color:var(--text);border-radius:10px;padding:8px 11px}
            .nav-main{flex-wrap:wrap}
            nav.open{display:flex;width:100%;flex-direction:column;align-items:flex-start;gap:14px;padding:12px 0}
            .weather-card{position:relative;right:auto;bottom:auto;margin:35px 24px 0}
            .hero-inner{padding-bottom:60px}
            .hero{min-height:780px;display:block;padding-top:70px}
            .planner{grid-template-columns:1fr}
            .capability-grid,.about-grid{grid-template-columns:repeat(2,1fr)}
        }
        @media(max-width:650px){
            .nav-container{padding-left:15px;padding-right:15px}
            .nav-controls{justify-content:space-between}
            .language{flex:1}
            .hero h1{font-size:45px}
            .hero p{font-size:16px}
            .section{padding:65px 15px}
            .form-grid{grid-template-columns:1fr}
            .full{grid-column:auto}
            .capability-grid,.about-grid{grid-template-columns:1fr}
            .card{padding:20px}
        }

        /* =========================================================
           RYTHUCROP — FINAL LAPTOP ONE-SCREEN FIX
           The page uses an inline <style> block in index.html,
           so this override must be inside this file.
           ========================================================= */

        @media (min-width: 951px) {

            :root {
                --slide-navbar-height: 120px;
            }

            html {
                scroll-behavior: smooth;
                scroll-padding-top: var(--slide-navbar-height);
            }

            body {
                overflow-x: hidden;
                overflow-y: auto;
            }

            /* Navbar occupies two rows in this design */
            .navbar {
                position: sticky;
                top: 0;
                z-index: 1000;
            }

   /* =========================================================
