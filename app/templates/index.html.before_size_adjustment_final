function normalizeCrop(v){const s=String(v||"").trim();const m={rice:"Rice","వరి":"Rice","చావల్":"Rice","चावल":"Rice","நெல்":"Rice","ಭತ್ತ":"Rice","നെല്ല്":"Rice","तांदूळ":"Rice","ধান":"Rice",wheat:"Wheat","గోధుమ":"Wheat","गेहूं":"Wheat","கோதுமை":"Wheat","ಗೋಧಿ":"Wheat","ഗോതമ്പ്":"Wheat","गहू":"Wheat","গম":"Wheat",maize:"Maize","మొక్కజొన్న":"Maize","मक्का":"Maize","மக்காச்சோளம்":"Maize","ಮೆಕ್ಕೆಜೋಳ":"Maize","ചോളം":"Maize","मका":"Maize","ভুট্টা":"Maize",cotton:"Cotton","పత్తి":"Cotton","कपास":"Cotton","பருத்தி":"Cotton","ಹತ್ತಿ":"Cotton","പരുത്തി":"Cotton","कापूस":"Cotton","তুলা":"Cotton",groundnut:"Groundnut",peanut:"Groundnut","వేరుశెనగ":"Groundnut","मूंगफली":"Groundnut","நிலக்கடலை":"Groundnut","ಕಡಲೆಕಾಯಿ":"Groundnut","നിലക്കടല":"Groundnut","भुईमूग":"Groundnut","চিনাবাদাম":"Groundnut",chickpea:"Chickpea",gram:"Chickpea","శనగ":"Chickpea","चना":"Chickpea","கொண்டைக்கடலை":"Chickpea","ಕಡಲೆ":"Chickpea","കടല":"Chickpea","हरभरा":"Chickpea","ছোলা":"Chickpea"};return m[s.toLowerCase()]||m[s]||s;}
function normalizeSeasonInput(v){const s=String(v||"").trim();const m={kharif:"Kharif","ఖరీఫ్":"Kharif","खरीफ":"Kharif","காரிஃப்":"Kharif","ಖರೀಫ್":"Kharif","ഖരീഫ്":"Kharif","खरीप":"Kharif","খরিফ":"Kharif",rabi:"Rabi","రబీ":"Rabi","रबी":"Rabi","ரபி":"Rabi","ರಬಿ":"Rabi","റബി":"Rabi","रब्बी":"Rabi","রবি":"Rabi",summer:"Summer","వేసవి":"Summer","गर्मी":"Summer","கோடை":"Summer","ಬೇಸಿಗೆ":"Summer","വേനൽ":"Summer","उन्हाळा":"Summer","গ্রীষ্ম":"Summer"};return m[s.toLowerCase()]||m[s]||s;}
document.getElementById("cropForm").addEventListener("submit",async e=>{e.preventDefault();const box=document.getElementById("cropResult"),r=document.getElementById("recommendedCrop"),t=T();box.classList.remove("hidden");r.textContent=t.calculating;try{const response=await fetch("/predict",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({N:parseFloat(N.value),P:parseFloat(P.value),K:parseFloat(K.value),temperature:parseFloat(temperature.value),humidity:parseFloat(humidity.value),ph:parseFloat(ph.value),rainfall:parseFloat(rainfall.value)})});const o=await response.json();if(o.recommended_crop){r.dataset.raw=normalizeCrop(o.recommended_crop);r.textContent=cropLabel(r.dataset.raw);}else r.textContent=t.prediction_failed;}catch(x){r.textContent=t.server_error;console.error(x);}});
document.getElementById("yieldForm").addEventListener("submit",async e=>{e.preventDefault();const box=document.getElementById("yieldResult"),r=document.getElementById("predictedYield"),t=T();const data={Crop:normalizeCrop(document.getElementById("Crop").value),Crop_Year:Number(document.getElementById("Crop_Year").value),Season:normalizeSeasonInput(document.getElementById("Season").value),State:document.getElementById("State").value,Area:Number(document.getElementById("Area").value),Production:Number(document.getElementById("Production").value),Annual_Rainfall:Number(document.getElementById("Annual_Rainfall").value),Fertilizer:Number(document.getElementById("Fertilizer").value),Pesticide:Number(document.getElementById("Pesticide").value)};box.classList.remove("hidden");r.textContent=t.calculating;try{const response=await fetch("/predict-yield",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(data)});const o=await response.json();if(o.predicted_yield!==undefined)r.textContent=Number(o.predicted_yield).toFixed(2)+" "+t.unit_tonnes_ha;else r.textContent=t.prediction_failed;}catch(x){r.textContent=t.server_error;console.error(x);}});
function renderAdvice(crop,priority){const t=T(),title=document.getElementById("adviceTitle"),list=document.getElementById("adviceList");title.dataset.rawCrop=crop;title.dataset.rawPriority=priority;title.textContent=fmt(t.advice_title_dynamic||"{crop} • {priority}",{crop:cropLabel(crop),priority:priorityLabel(priority)});const m={"Water saving":"Use irrigation according to crop stage and avoid unnecessary watering.","Fertilizer management":"Prefer balanced nutrient application based on soil condition and crop requirement.","Pest prevention":"Inspect leaves and crop rows early; act according to a verified local recommendation.","Higher yield":"Focus on timely sowing, adequate nutrition, irrigation and regular field monitoring."};const advice=m[priority]||priority;list.innerHTML=[advice,`Check crop growth and field conditions regularly for ${cropLabel(crop)}.`,`Use soil-test information before changing fertilizer quantities.`].map(x=>`<div class="recommendation-item">✓ ${x}</div>`).join("");}
document.getElementById("adviceBtn").addEventListener("click",()=>renderAdvice(document.getElementById("adCrop").value,document.getElementById("adPriority").value));
/* RythuCrop - Single Section Navigation */
function showSection(id) {
    document.querySelectorAll("main > section").forEach(section => {
        section.classList.remove("active-section");
    });

    const target = document.getElementById(id);

    if (target) {
        target.classList.add("active-section");

        // Footer should appear only on About section
        document.body.classList.toggle("about-active", id === "about");

        window.scrollTo({
            top: 0,
            behavior: "smooth"
        });
    }
}

document.querySelectorAll('#mainNav a[href^="#"]').forEach(link => {
    link.addEventListener("click", function(e) {
        e.preventDefault();
        const id = this.getAttribute("href").substring(1);
        showSection(id);
    });
});

document.querySelectorAll('.hero-buttons a[href^="#"]').forEach(link => {
    link.addEventListener("click", function(e) {
        e.preventDefault();
        const id = this.getAttribute("href").substring(1);
        showSection(id);
    });
});

const initialSection = window.location.hash
    ? window.location.hash.substring(1)
    : "home";

showSection(initialSection);
