            }

            #planning input,
            #planning select,
            #recommendation input,
            #recommendation select,
            #yield input,
            #yield select,
            #advisory input,
            #advisory select {
                height: 38px;
                min-height: 38px;
                padding: 7px 11px;
                font-size: 13px;
            }

            /* Result panels */
            #planning .result-panel,
            #advisory .result-panel {
                min-height: 0;
                height: 100%;
                max-height: 100%;
                padding: 18px;
                overflow: hidden;
            }

            #recommendation .result-panel,
            #yield .result-panel {
                max-height: 110px;
                overflow: hidden;
            }

            #planning .recommendation-list,
            #advisory .recommendation-list {
                max-height: 150px;
                overflow: hidden;
            }

            /* About */
            #about .about-grid {
                width: min(1250px, 100%);
                margin: 0 auto;
                grid-template-columns: repeat(3, 1fr);
                gap: 14px;
            }

            #about .about-card {
                padding: 18px;
            }
        }


        /* =========================================================
           RYTHUCROP FINAL DESKTOP FIX
           This is intentionally last so it overrides all earlier
           desktop section rules in this same inline stylesheet.
           ========================================================= */
        @media (min-width:951px){

            /* Real navbar height is measured by JS below. */
            :root{
                --actual-navbar-height:120px;
            }

            html{
                scroll-behavior:smooth;
                scroll-padding-top:var(--actual-navbar-height);
            }

            #home,
            #planning,
            #recommendation,
