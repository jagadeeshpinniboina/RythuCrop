            /* RythuCrop - Balanced Final Section Layout */

body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

/* Every section fits within the visible page */
main > section {
    box-sizing: border-box;
    min-height: calc(100vh - var(--actual-navbar-height, 100px));
}

/* Footer only on About */
body:not(.about-active) > footer {
    display: none !important;
}

body.about-active > footer {
    display: block !important;
    margin-top: auto !important;
    flex-shrink: 0 !important;
}


/* =========================
   FARM PLANNING
   ========================= */

#planning.section {
    min-height: calc(100vh - var(--actual-navbar-height, 100px));
    padding-top: 52px !important;
    padding-bottom: 52px !important;
}

#planning .section-heading {
    margin-bottom: 28px !important;
}

#planning .section-heading h2 {
    font-size: 34px !important;
    margin-bottom: 7px !important;
}


/* =========================
   CROP RECOMMENDATION
   ========================= */

#recommendation.section {
    min-height: calc(100vh - var(--actual-navbar-height, 100px));
    padding-top: 48px !important;
    padding-bottom: 48px !important;
}

#recommendation .section-heading {
    margin-bottom: 26px !important;
}

#recommendation .section-heading h2 {
    font-size: 34px !important;
    margin-bottom: 7px !important;
}


/* =========================
   YIELD PREDICTION
   ========================= */

#yield.section {
    min-height: calc(100vh - var(--actual-navbar-height, 100px));
    padding-top: 48px !important;
    padding-bottom: 48px !important;
}

#yield .section-heading {
    margin-bottom: 26px !important;
}

#yield .section-heading h2 {
    font-size: 34px !important;
    margin-bottom: 7px !important;
}


/* =========================
   SMART ADVISORY
   ========================= */

#advisory.section {
    min-height: calc(100vh - var(--actual-navbar-height, 100px));
    padding-top: 60px !important;
    padding-bottom: 60px !important;
}

#advisory .section-heading {
    margin-bottom: 34px !important;
}

#advisory .section-heading h2 {
    font-size: 38px !important;
    margin-bottom: 9px !important;
}

#advisory .advisory-grid,
#advisory .form-card,
#advisory .result-card {
    min-height: 170px;
}


/* =========================
   ABOUT
   ========================= */

body.about-active main > section#about {
    min-height: calc(100vh - var(--actual-navbar-height, 100px) - 125px);
    box-sizing: border-box;
    padding-top: 48px !important;
    padding-bottom: 32px !important;
}

#about .section-heading {
    margin-bottom: 28px !important;
}

#about .section-heading h2 {
    font-size: 34px !important;
    margin-bottom: 7px !important;
}


/* About footer stays at the bottom */
body.about-active > footer {
    margin-top: auto !important;
    flex-shrink: 0 !important;
}


/* =========================
   PREVENT SECTION OVERFLOW
   ========================= */

main > section {
    overflow: hidden;
}

</style>
</head>

<body>
<header class="navbar">
    <div class="nav-container">
        <div class="nav-main">
            <a class="brand" href="#home">
                <span class="brand-icon">🌾</span>
                <span>RythuCrop</span>
            </a>

            <button class="mobile-menu" id="menuBtn">☰</button>

            <nav id="mainNav">
                <a href="#home" data-i18n="nav_home">Home</a>
                <a href="#planning" data-i18n="nav_planning">Farm Planning</a>
                <a href="#recommendation" data-i18n="nav_crop">Crop Recommendation</a>
                <a href="#yield" data-i18n="nav_yield">Yield Prediction</a>
                <a href="#advisory" data-i18n="nav_advisory">Smart Advisory</a>
