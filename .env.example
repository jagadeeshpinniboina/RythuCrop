# RythuCrop Environment Configuration
# Copy this file to .env and customize for your deployment environment

# Flask Security
SECRET_KEY=your-production-secret-key-change-me-in-production
FLASK_ENV=development
FLASK_DEBUG=False

# Authentication Settings
# Set to 'false' in production to require real SMS OTP delivery
RYTHUCROP_DEV_AUTH=true

# External SMS Provider (When RYTHUCROP_DEV_AUTH=false)
SMS_API_KEY=your-fast2sms-or-msg91-or-twilio-key
SMS_SENDER_ID=RYTHUC

# Optional External Mapping Provider
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-if-configured

# Database (Default is SQLite file rythucrop.db)
DATABASE_URL=sqlite:///rythucrop.db
